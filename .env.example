# =============================================================================
# Root Environment Configuration
# On-Premise RAG-LLM System v2
# =============================================================================

# --- Host Paths ---
DOC_WATCH_DIR=/data/documents

# --- PostgreSQL ---
# REQUIRED
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_system
POSTGRES_USER=admin
# REQUIRED — set via Docker secret or direct env (never commit a real value)
POSTGRES_PASSWORD=
# OPTIONAL — alternative to POSTGRES_PASSWORD when using Docker secrets
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
POSTGRES_DATA_DIR=/data/db/postgres

# --- Neo4j ---
# REQUIRED
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
# REQUIRED — set via Docker secret or direct env (never commit a real value)
NEO4J_PASSWORD=
# OPTIONAL — alternative to NEO4J_PASSWORD when using Docker secrets
# NEO4J_PASSWORD_FILE=/run/secrets/neo4j_password
NEO4J_DATA_DIR=/data/db/neo4j

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_DATA_DIR=/data/db/redis

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- JWT ---
# REQUIRED — set via Docker secret or direct env (never commit a real value)
JWT_SECRET=
# OPTIONAL — alternative to JWT_SECRET when using Docker secrets
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# OPTIONAL
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# --- Embedding Model (BGE-M3, 1024-dim) ---
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_DIR=/data/models/embedding
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32

# --- Reranker Model ---
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_DIR=/data/models/reranker
RERANKER_DEVICE=cuda

# --- vLLM ---
VLLM_BASE_URL=http://vllm-server:8000/v1
VLLM_MODEL_NAME=local-llm
# Hugging Face repo ID or local mounted model path, e.g. /models/vllm/Qwen2.5-72B-Instruct-AWQ
VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct-AWQ
VLLM_QUANTIZATION=awq
VLLM_TENSOR_PARALLEL=1
VLLM_GPU_MEM_UTIL=0.90
VLLM_MAX_MODEL_LEN=32768
VLLM_SERVED_MODEL_NAME=local-llm
VLLM_MODEL_DIR=/data/models/vllm
VLLM_GPU_COUNT=1
PREFER_ENV_LLM_CONFIG=true

# --- MinerU OCR ---
MINERU_API_URL=http://mineru-api:9000
MINERU_BACKEND=hybrid-auto-engine
MINERU_LANG=korean
MINERU_MODEL_DIR=/data/models/mineru
MINERU_OUTPUT_DIR=/data/images/mineru_output

# --- Chunking ---
CHUNK_STRATEGY=hybrid
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_MIN_SECTION_TOKENS=80

# --- Image ---
ENABLE_IMAGE_EMBEDDING=true
IMAGE_STORE_DIR=/data/images

# --- Web Search (Google Custom Search API) ---
WEB_SEARCH_ENABLED=true
GOOGLE_API_KEY=
GOOGLE_CX=

# --- HuggingFace ---
HF_TOKEN=

# --- Development / Smoke Validation ---
SMOKE_TEST_MODE=false

# --- Sync Schedule ---
SYNC_INTERVAL_MINUTES=30
SOURCE_SCAN_PATHS=/data/documents
PIPELINE_API_URL=http://pipeline-api:8001
DEFAULT_DEPT_ID=1
DEFAULT_ROLE_ID=3

# --- Frontend ---
# Leave empty to use the current browser host with port 8002.
# Example for remote access: http://192.168.0.10:8002
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_PORT=8002

# --- Serving CORS ---
# Frontend port used for local/default CORS inference.
FRONTEND_PORT=3000
# Additional allowed frontend origins for the serving API, comma-separated.
# Example: http://192.168.0.10:3000,http://my-hostname:3000
CORS_ALLOW_ORIGINS=

# --- Serving Fallback / Retrieval Tuning ---
FALLBACK_SYSTEM_PROMPT=당신은 사내 문서를 기반으로 답변하는 AI 어시스턴트입니다. 제공된 문서 내용을 바탕으로 정확하고 도움이 되는 답변을 제공하세요.
FALLBACK_MAX_TOKENS=4096
FALLBACK_TEMPERATURE=0.7
FALLBACK_TOP_P=0.9
FALLBACK_CONTEXT_CHUNKS=5
RETRIEVAL_CONTEXT_EXPANSION_FACTOR=4
RETRIEVAL_MIN_LIMIT=20
RETRIEVAL_MAX_CANDIDATES=60
RETRIEVAL_BASE_CANDIDATE_MULTIPLIER=2
RETRIEVAL_INTENT_CANDIDATE_MULTIPLIER=3
RETRIEVAL_FOCUSED_LIMIT_MULTIPLIER=2
RETRIEVAL_FOCUSED_MIN_LIMIT=12
RERANK_MODEL_WEIGHT=0.55
RERANK_PRIOR_WEIGHT=0.30
RERANK_FEATURE_WEIGHT=0.15
RETRIEVAL_BUDGET_GENERAL=
RETRIEVAL_BUDGET_TABLE=table:8,caption:4,text:8
RETRIEVAL_BUDGET_IMAGE=image:8,caption:6,text:6
RETRIEVAL_BUDGET_CAPTION=caption:8,image:4,table:4,text:4
RETRIEVAL_BUDGET_SLIDE=text:10,caption:4,table:4
RETRIEVAL_BUDGET_PAGE=text:10,table:4,caption:4
