# =============================================================================
# Logging (shared by all modules via packages/shared-py/rag_shared/logging.py)
# - LOG_FILE_PATH: when set, the module writes JSON logs to this path in
#   addition to stdout. Path is bind-mounted to data/logs/<module>/ on host.
# - LOG_FILE_REQUIRED=1: fail-fast if the file handler can't be created
#   (otherwise stdout still works). Recommended in prod.
# - LOG_MAX_BYTES / LOG_BACKUP_COUNT: rotation tuning (default 10MB × 5).
# Each module sets LOG_FILE_PATH in its own docker-compose.module.yml.
LOG_FILE_REQUIRED=0
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# Root Environment Configuration — Single Source of Truth
# On-Premise RAG-LLM v2 (8-module monorepo)
# -----------------------------------------------------------------------------
# Container env_file in each module's docker-compose.module.yml points to the
# monorepo root .env (this file's runtime sibling). Module .env.example files
# are kept as documentation pointers only — do not duplicate values there.
#
# Copy this to .env and fill in actual values:
#   cp .env.example .env
# DATA_DIR / LOG_DIR / ROOT are managed by the Makefile (absolute paths) — do
# not set them here.
# =============================================================================

# ─── PostgreSQL ────────────────────────────────────────────────────────────
# Inside the docker network. Override host to localhost for direct access.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
# REQUIRED — set via Docker secret or direct env (never commit a real value)
POSTGRES_PASSWORD=
# Sync driver (psycopg) — used by m1, m3, m4
POSTGRES_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ragdb
# Async driver (asyncpg) — used by m7
POSTGRES_ASYNC_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ragdb
# Async read-only replica — used by m7
POSTGRES_RO_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ragdb

# ─── Neo4j (m4-rag) ────────────────────────────────────────────────────────
NEO4J_AUTH=neo4j/password
NEO4J_USER=neo4j
# REQUIRED — set via Docker secret or direct env (never commit a real value)
NEO4J_PASSWORD=
NEO4J_URL=bolt://neo4j:7687

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── JWT (m1, m5, m7) ──────────────────────────────────────────────────────
# REQUIRED — minimum 32 chars
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ─── Module implementation switch ──────────────────────────────────────────
# real | mock — passed to every module
MODULE_IMPL=real

# ─── Inter-module sync (m1 → m2 ordered trigger) ───────────────────────────
# Shared secret used by m1-identity to authenticate calls to m2-doc-to-md's
# /internal/sync/mysql endpoint after a successful identity sync.
# REQUIRED for m1→m2 trigger to succeed
INTERNAL_SYNC_TOKEN=
# m1 → m2 trigger URL. Leave empty on m1 side to disable the chained trigger.
M2_INTERNAL_SYNC_URL=http://m2-doc-to-md:8000/internal/sync/mysql
# HTTP timeout for the m1→m2 trigger call (seconds)
M2_TRIGGER_TIMEOUT_SECONDS=5
# Redis SETNX TTL for sync locks (m1 + m2). Bump if a single sync run can
# legitimately exceed 30 minutes; otherwise the lock auto-releases mid-run
# and a sibling worker may start a duplicate sync.
SYNC_LOCK_TTL_SECONDS=1800

# ─── Service discovery URLs (m5-gateway, m7-admin) ─────────────────────────
M1_URL=http://m1-identity:8000
M2_URL=http://m2-doc-to-md:8000
M3_URL=http://m3-chunk-embed:8000
M3_API_URL=http://m3-chunk-embed:8000
M4_URL=http://m4-rag:8000
M5_URL=http://m5-gateway:8000
M7_URL=http://m7-admin:8000
M8_URL=http://m8-web-search:8000

# ─── m1-identity ───────────────────────────────────────────────────────────
# Upstream HR DB (read-only, external — not managed by docker-compose)
MYSQL_URL=mysql+asyncmy://user:pass@hr-host:3306/hr
MYSQL_TABLE_USERS=USER_INFO
MYSQL_SYNC_INTERVAL_MINUTES=60
MYSQL_SYNC_BATCH_SIZE=1000
MYSQL_SYNC_ON_STARTUP=0
# Connection pool tuning (shared by m1 + m2 mysql clients)
MYSQL_POOL_SIZE=5
MYSQL_POOL_RECYCLE_SECONDS=1800
# Auto-bootstrap on first startup (Phase 3 — admin seeding)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ─── m2-doc-to-md ──────────────────────────────────────────────────────────
# State directory inside container (bind-mounted from data/db/m2-state/)
M2_STATE_DIR=/app/.state
M2_SYNC_HISTORY_LIMIT=50
# Filesystem scan source/output (paths inside the m2 container)
M2_SOURCE_DIR=/data/documents
M2_OUTPUT_DIR=/data/markdown
# Upstream search server (F0_00001_F file metadata + per-file ACL)
M2_MYSQL_FILE_URL=mysql+asyncmy://user:pass@search-host:3306/search
M2_MYSQL_TABLE_FILES=F0_00001_F
# Upstream HR DB (PDiskFolderPermission2 folder ACL — typically same server as MYSQL_URL)
M2_MYSQL_HR_URL=mysql+asyncmy://user:pass@hr-host:3306/hr
M2_MYSQL_TABLE_FOLDER_PERMS=PDiskFolderPermission2
KORDOC_BIN=kordoc

# ─── m3-chunk-embed ────────────────────────────────────────────────────────
M3_MAX_CONCURRENT=4
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_DIR=/data/models/embedding
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32
CHUNK_STRATEGY=hybrid
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_MIN_SECTION_TOKENS=80

# ─── m4-rag ────────────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-m3
VLLM_URL=http://vllm-server:8000/v1
VLLM_MODEL=local-llm
VLLM_BASE_URL=http://vllm-server:8000/v1
VLLM_MODEL_NAME=local-llm
VLLM_QUANTIZATION=awq
VLLM_TENSOR_PARALLEL=1
VLLM_GPU_MEM_UTIL=0.90
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_COUNT=1
# Hybrid retrieval weights
BM25_WEIGHT=0.3
VEC_WEIGHT=0.7
RRF_K=60
MAX_CONTEXT_TOKENS=4096
SESSION_TTL=3600
# Reranker
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_DIR=/data/models/reranker
RERANKER_DEVICE=cuda
RERANK_MODEL_WEIGHT=0.55
RERANK_PRIOR_WEIGHT=0.30
RERANK_FEATURE_WEIGHT=0.15

# ─── m5-gateway ────────────────────────────────────────────────────────────
# Comma-separated origins; empty means infer from FRONTEND_PORT
ALLOWED_ORIGINS=
HTTPS_ENABLED=false
# Service-to-service auth + downstream behavior
DOWNSTREAM_FALLBACK=mock
DOWNSTREAM_SERVICE_TOKEN=
M5_AUDIT_HASH_SALT=
METRICS_USER=metrics
METRICS_PASSWORD=metrics

# ─── m8-web-search ─────────────────────────────────────────────────────────
M8_DEFAULT_PROVIDER=curated
M8_CACHE_TTL_SECONDS=900
M8_AUDIT_LOG=/var/log/m8-web-search/audit.jsonl
M8_AUDIT_HASH_SALT=
# Comma-separated; empty means no allow/deny enforcement
M8_ALLOWED_DOMAINS=
M8_DENIED_DOMAINS=
M8_CONFIDENTIAL_TERMS=
# External providers (leave unset for offline/curated operation)
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
SEARXNG_URL=http://searxng:8080

# ─── External / shared infra ───────────────────────────────────────────────
# Web Search (Google Custom Search API)
WEB_SEARCH_ENABLED=true
GOOGLE_API_KEY=
GOOGLE_CX=
# HuggingFace (model downloads)
HF_TOKEN=
# MinerU OCR
MINERU_API_URL=http://mineru-api:9000
MINERU_BACKEND=hybrid-auto-engine
MINERU_LANG=korean
MINERU_MODEL_DIR=/data/models/mineru
MINERU_OUTPUT_DIR=/data/images/mineru_output
# Image embedding
ENABLE_IMAGE_EMBEDDING=true
IMAGE_STORE_DIR=/data/images
# vLLM model dir
VLLM_MODEL_DIR=/data/models/vllm
# Document watch dir (filesystem scan source)
DOC_WATCH_DIR=/data/documents
SOURCE_SCAN_PATHS=/data/documents
# Default org/role for unmatched users
DEFAULT_DEPT_ID=1
DEFAULT_ROLE_ID=3

# ─── Frontend (m6-ui, m7-admin/frontend) ───────────────────────────────────
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_PORT=8002
FRONTEND_PORT=3000
CORS_ALLOW_ORIGINS=

# ─── Smoke / dev ───────────────────────────────────────────────────────────
SMOKE_TEST_MODE=false
PREFER_ENV_LLM_CONFIG=true
