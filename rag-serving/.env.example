# rag-serving specific overrides
# Inherits all shared settings from root .env

# --- vLLM ---
VLLM_BASE_URL=http://vllm-server:8000/v1
VLLM_MODEL_NAME=qwen2.5-72b

# --- Web Search (Google Custom Search API) ---
GOOGLE_API_KEY=
GOOGLE_CX=

# --- Serving ---
SERVING_API_PORT=8002
FRONTEND_PORT=3000
NEXT_PUBLIC_API_PORT=8002

# Additional allowed frontend origins for the serving API, comma-separated.
CORS_ALLOW_ORIGINS=

FALLBACK_SYSTEM_PROMPT=당신은 사내 문서를 기반으로 답변하는 AI 어시스턴트입니다. 제공된 문서 내용을 바탕으로 정확하고 도움이 되는 답변을 제공하세요.
FALLBACK_MAX_TOKENS=4096
FALLBACK_TEMPERATURE=0.7
FALLBACK_TOP_P=0.9
FALLBACK_CONTEXT_CHUNKS=5
RETRIEVAL_CONTEXT_EXPANSION_FACTOR=4
RETRIEVAL_MIN_LIMIT=20
RETRIEVAL_MAX_CANDIDATES=60
RETRIEVAL_BASE_CANDIDATE_MULTIPLIER=2
RETRIEVAL_INTENT_CANDIDATE_MULTIPLIER=3
RETRIEVAL_FOCUSED_LIMIT_MULTIPLIER=2
RETRIEVAL_FOCUSED_MIN_LIMIT=12
RERANK_MODEL_WEIGHT=0.55
RERANK_PRIOR_WEIGHT=0.30
RERANK_FEATURE_WEIGHT=0.15
RETRIEVAL_BUDGET_GENERAL=
RETRIEVAL_BUDGET_TABLE=table:8,caption:4,text:8
RETRIEVAL_BUDGET_IMAGE=image:8,caption:6,text:6
RETRIEVAL_BUDGET_CAPTION=caption:8,image:4,table:4,text:4
RETRIEVAL_BUDGET_SLIDE=text:10,caption:4,table:4
RETRIEVAL_BUDGET_PAGE=text:10,table:4,caption:4
