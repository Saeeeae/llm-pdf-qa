# m7-admin/backend reads env vars from the monorepo root .env at runtime.
# Set actual values in <ROOT>/.env. See <ROOT>/.env.example for defaults.
#
# Required:
#   POSTGRES_URL                psycopg URL — m7 auto-converts to asyncpg
#   POSTGRES_ASYNC_URL          (optional) preferred over POSTGRES_URL when set
#   POSTGRES_RO_URL             (optional) read-only replica, asyncpg, takes
#                               precedence over both URLs above
#   REDIS_URL
#   JWT_SECRET                  (shared with m1, m5)
#
# Resolution order at runtime:
#   POSTGRES_RO_URL → POSTGRES_ASYNC_URL → POSTGRES_URL (psycopg→asyncpg auto)
#
# Service discovery:
#   M1_URL, M2_URL, M3_URL, M4_URL, M5_URL, M8_URL
#
# m8 ACL passthrough:
#   M8_DEFAULT_PROVIDER, M8_ALLOWED_DOMAINS, M8_DENIED_DOMAINS,
#   M8_CONFIDENTIAL_TERMS
#
# Common:
#   MODULE_IMPL                 real | mock
#   JWT_ALGORITHM
