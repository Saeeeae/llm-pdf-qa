# m4-rag reads env vars from the monorepo root .env at runtime.
# Set actual values in <ROOT>/.env. See <ROOT>/.env.example for defaults.
#
# Required:
#   POSTGRES_URL                (psycopg sync, pgvector schema)
#   REDIS_URL
#   NEO4J_URL                   default: bolt://neo4j:7687
#
# m4-specific:
#   EMBED_MODEL                 default: BAAI/bge-m3
#   VLLM_URL                    default: http://vllm-server:8000/v1
#   VLLM_MODEL                  default: local-llm
#   BM25_WEIGHT                 default: 0.3
#   VEC_WEIGHT                  default: 0.7
#   RRF_K                       default: 60
#   MAX_CONTEXT_TOKENS          default: 4096
#   SESSION_TTL                 default: 3600
#   RERANKER_MODEL_NAME         default: BAAI/bge-reranker-v2-m3
#   RERANK_MODEL_WEIGHT/PRIOR_WEIGHT/FEATURE_WEIGHT
#
# Common:
#   MODULE_IMPL                 real | mock
