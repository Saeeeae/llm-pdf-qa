POSTGRES_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ragdb
REDIS_URL=redis://redis:6379/0
NEO4J_URL=bolt://neo4j:7687
MODULE_IMPL=real

# Conversation session lifetime in Redis (seconds)
SESSION_TTL=3600

# vLLM
VLLM_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
MAX_CONTEXT_TOKENS=6000
CHARS_PER_TOKEN=2.0
HISTORY_TOKEN_BUDGET=1500
MAX_HISTORY_TURNS=10

# Query embedder shares the same /data/models cache as m3
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=auto
HF_HOME=/data/models
TRANSFORMERS_CACHE=/data/models
SENTENCE_TRANSFORMERS_HOME=/data/models

# Reranker (cross-encoder)
USE_RERANKER=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=auto
RERANK_ALPHA=0.7

# Retrieval pipeline
RETRIEVE_K=40
RERANK_K=8
RRF_K=60
VEC_WEIGHT=1.0
BM25_WEIGHT=1.0
MMR_LAMBDA=0.5
