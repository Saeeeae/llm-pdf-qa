POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ragdb
JWT_SECRET=change-me
MODULE_IMPL=real

# MySQL source (read-only, external — not managed by docker-compose)
MYSQL_URL=mysql+asyncmy://user:pass@mysql-host:3306/hr
MYSQL_TABLE_USERS=hr_users
MYSQL_TABLE_ROLES=hr_roles
MYSQL_TABLE_DEPARTMENTS=hr_departments
MYSQL_SYNC_INTERVAL_MINUTES=60
MYSQL_SYNC_ON_STARTUP=0
MYSQL_SYNC_BATCH_SIZE=1000
