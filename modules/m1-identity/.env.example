# m1-identity reads env vars from the monorepo root .env at runtime.
# This file lists what m1 needs — set actual values in <ROOT>/.env.
# See <ROOT>/.env.example for defaults.
#
# Required (must be set):
#   JWT_SECRET                  (>=32 chars)
#   POSTGRES_URL                (psycopg sync)
#   REDIS_URL
#   MYSQL_URL                   (in-house HR DB)
#   INTERNAL_SYNC_TOKEN         (shared with m2)
#
# m1-specific:
#   MYSQL_TABLE_USERS           default: USER_INFO
#   MYSQL_SYNC_INTERVAL_MINUTES default: 60
#   MYSQL_SYNC_BATCH_SIZE       default: 1000
#   MYSQL_SYNC_ON_STARTUP       default: 0
#   M2_INTERNAL_SYNC_URL        m1 → m2 trigger; empty disables chain
#   BOOTSTRAP_ADMIN_EMAIL       (Phase 3 — admin auto-create)
#   BOOTSTRAP_ADMIN_PASSWORD    (Phase 3 — admin auto-create)
#
# Common:
#   MODULE_IMPL                 real | mock
#   JWT_ALGORITHM, JWT_ACCESS_EXPIRE_MINUTES, JWT_REFRESH_EXPIRE_DAYS
