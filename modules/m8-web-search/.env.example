# m8-web-search reads env vars from the monorepo root .env at runtime.
# Set actual values in <ROOT>/.env. See <ROOT>/.env.example for defaults.
#
# m8-specific:
#   M8_DEFAULT_PROVIDER         default: curated  (curated | brave | exa | searxng)
#   M8_CACHE_TTL_SECONDS        default: 900
#   M8_AUDIT_LOG                default: /var/log/m8-web-search/audit.jsonl
#   M8_AUDIT_HASH_SALT          PII hash salt
#   M8_ALLOWED_DOMAINS          comma-separated, empty = no allow filter
#   M8_DENIED_DOMAINS           comma-separated
#   M8_CONFIDENTIAL_TERMS       comma-separated terms to scrub
#
# Provider credentials (leave unset for offline/curated operation):
#   BRAVE_SEARCH_API_KEY
#   EXA_API_KEY
#   SEARXNG_URL                 default: http://searxng:8080
#
# Common:
#   MODULE_IMPL                 real | mock
