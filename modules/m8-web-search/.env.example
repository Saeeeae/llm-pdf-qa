MODULE_IMPL=real
M8_DEFAULT_PROVIDER=curated
M8_CACHE_TTL_SECONDS=900
M8_AUDIT_LOG=/data/logs/m8-web-search.jsonl

# Comma separated. If M8_ALLOWED_DOMAINS is set, all result URLs must match it.
M8_ALLOWED_DOMAINS=
M8_DENIED_DOMAINS=
M8_CONFIDENTIAL_TERMS=

# External providers. Leave unset for offline/curated operation.
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
SEARXNG_URL=http://searxng:8080
