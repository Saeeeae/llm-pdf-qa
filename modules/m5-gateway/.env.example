# m5-gateway reads env vars from the monorepo root .env at runtime.
# Set actual values in <ROOT>/.env. See <ROOT>/.env.example for defaults.
#
# Required:
#   JWT_SECRET                  (>=32 chars, shared with m1)
#   REDIS_URL
#
# m5-specific:
#   ALLOWED_ORIGINS             CORS allowlist (comma-separated)
#   HTTPS_ENABLED               default: false
#   DOWNSTREAM_FALLBACK         default: mock
#   DOWNSTREAM_SERVICE_TOKEN    inter-service auth token
#   M5_AUDIT_HASH_SALT          PII hash salt
#   METRICS_USER / METRICS_PASSWORD   /metrics basic auth
#
# Service discovery:
#   M1_URL, M2_URL, M3_URL, M4_URL, M7_URL, M8_URL
#
# Common:
#   MODULE_IMPL                 real | mock
