# m2-doc-to-md reads env vars from the monorepo root .env at runtime.
# This file lists what m2 needs — set actual values in <ROOT>/.env.
# See <ROOT>/.env.example for defaults.
#
# Required (must be set):
#   REDIS_URL
#   INTERNAL_SYNC_TOKEN         (shared with m1, used to gate /internal/sync/mysql)
#   M2_MYSQL_FILE_URL           (search server F0_00001_F)
#   M2_MYSQL_HR_URL             (HR DB PDiskFolderPermission2)
#
# m2-specific:
#   M2_SOURCE_DIR               default: /data/documents
#   M2_OUTPUT_DIR               default: /data/markdown
#   M2_MYSQL_TABLE_FILES        default: F0_00001_F
#   M2_MYSQL_TABLE_FOLDER_PERMS default: PDiskFolderPermission2
#   M3_API_URL                  default: http://m3-chunk-embed:8000
#   KORDOC_BIN                  default: kordoc
#
# Common:
#   MODULE_IMPL                 real | mock
