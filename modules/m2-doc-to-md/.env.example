POSTGRES_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ragdb
REDIS_URL=redis://redis:6379/0
MODULE_IMPL=real

# Storage paths (default values match the Docker bind mounts in infra/docker-compose.yml)
M2_SOURCE_DIR=/data2
M2_OUTPUT_DIR=/data/markdown
M2_STATE_DIR=/data/state
M2_LOG_DIR=/data/logs

# Downstream
M3_API_URL=http://m3-chunk-embed:8000
