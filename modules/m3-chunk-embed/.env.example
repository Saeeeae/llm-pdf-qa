# m3-chunk-embed reads env vars from the monorepo root .env at runtime.
# Set actual values in <ROOT>/.env. See <ROOT>/.env.example for defaults.
#
# Required:
#   POSTGRES_URL                (psycopg sync, pgvector schema)
#   REDIS_URL
#
# m3-specific:
#   M3_MAX_CONCURRENT           default: 4
#   EMBEDDING_MODEL_NAME        default: BAAI/bge-m3
#   EMBEDDING_DEVICE            default: cuda
#   EMBEDDING_BATCH_SIZE        default: 32
#   CHUNK_STRATEGY              default: hybrid
#   CHUNK_SIZE                  default: 512
#   CHUNK_OVERLAP               default: 50
#
# Common:
#   MODULE_IMPL                 real | mock
