POSTGRES_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ragdb
REDIS_URL=redis://redis:6379/0
MODULE_IMPL=real

# Embedding model + cache (cache lives on the bind-mounted /data/models volume)
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=auto
HF_HOME=/data/models
TRANSFORMERS_CACHE=/data/models
SENTENCE_TRANSFORMERS_HOME=/data/models

# Hierarchical chunking (parent provides expanded LLM context; leaf is the search target)
PARENT_CHUNK_SIZE=1024
PARENT_CHUNK_OVERLAP=100
CHUNK_SIZE=256
CHUNK_OVERLAP=32

# Concurrency
M3_MAX_CONCURRENT=2
